# Local dev: this file is NOT needed. `npm run dev` proxies /api to
# http://localhost:8000 (see vite.config.ts). If the API runs elsewhere:
#   BACKEND_URL=http://other-host:8000 npm run dev
#
# Production (Render Static Site ONLY): set this to the backend URL so the
# built bundle calls the API directly (no proxy on a static host).
# VITE_API_URL=https://flowguard-api.onrender.com
